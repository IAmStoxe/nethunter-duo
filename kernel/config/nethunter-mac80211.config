# Diagnostic/core fragment for soft-MAC USB Wi-Fi drivers.
CONFIG_MAC80211=m
# Do not enable CONFIG_MAC80211_MESH on the Duo OTA kernel. In this 4.14 tree
# it changes LL_MAX_HEADER in include/linux/netdevice.h from 96 to 128, which
# changes the vendor-module ABI. Monitor mode and injection do not need mesh.
