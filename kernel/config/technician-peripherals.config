# CAN and kernel VLAN support are omitted. Both have configuration guards
# inside exported networking types used by the stock vendor modules.

# USB SDR receivers and tuner dependencies
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_DVB_USB_V2=m
CONFIG_DVB_USB_RTL28XXU=m
CONFIG_USB_AIRSPY=m

# USB and read-only recovery storage support
CONFIG_USB_MON=m
CONFIG_USB_UAS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_NTFS_FS=m
CONFIG_SQUASHFS=m

# Network maintenance and supported USB adapters
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_SMSC75XX=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_BT_HCIBTUSB=m
