# ABI-conservative NetHunter radio expansion for Surface Duo 1.
# CAN remains in a separate fragment so radio-only and complete profiles are
# easy to compare. The accompanying CAN per-net patch prevents CONFIG_CAN from
# changing struct net and therefore preserves the OTA vendor-module ABI.

# Bluetooth Arsenal: serial profiles plus USB/UART/virtual HCI transports
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_ATH3K=m
CONFIG_BT_HCIBCM203X=m
CONFIG_BT_HCIBPA10X=m
CONFIG_BT_HCIBFUSB=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIVHCI=m

# mac80211 and common upstream USB Wi-Fi adapters. Do not enable
# CONFIG_MAC80211_MESH: Microsoft's 4.14 netdevice.h raises LL_MAX_HEADER when
# it is set, changing the ABI consumed by the OTA vendor modules. Monitor mode
# and injection do not require mesh. Legacy CFG80211_WEXT is also unnecessary.
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=m
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_USB_ZD1201=m
CONFIG_ZD1211RW=m
CONFIG_USB_NET_RNDIS_WLAN=m

# SDR receivers not present in the conservative baseline
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_USB_HACKRF=m
CONFIG_USB_MSI2500=m
