# Additional ABI-audited field interfaces. Everything is modular where the
# 4.14 Kconfig permits, so unused support consumes no runtime power.

# USB serial protocols used by embedded, modem, console, and debug hardware
CONFIG_USB_SERIAL_ARK3116=m
CONFIG_USB_SERIAL_BELKIN=m
CONFIG_USB_SERIAL_CYPRESS_M8=m
CONFIG_USB_SERIAL_F81232=m
CONFIG_USB_SERIAL_KEYSPAN=m
CONFIG_USB_SERIAL_MCT_U232=m
CONFIG_USB_SERIAL_TI=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_QUALCOMM=m
CONFIG_USB_SERIAL_SIMPLE=m

# Additional USB Ethernet, modem, and USB-over-IP transports
CONFIG_USB_NET_CDC_EEM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USBIP_CORE=m
CONFIG_USBIP_VHCI_HCD=m
CONFIG_USBIP_HOST=m

# Device-mode serial and standards-based USB Ethernet functions. Stock already
# supplies HID, mass storage, RNDIS, NCM, MIDI, and USB Audio Class 2 configfs
# functions; these complete the useful technician gadget set.
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_EEM=y

# Field storage and remote recovery filesystems. NTFS writes remain in
# userspace (ntfs-3g); the old in-kernel NTFS writer is intentionally omitted.
CONFIG_BLK_DEV_NBD=m
CONFIG_NFS_FS=m
CONFIG_NFS_V3=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_SCSI_ISCSI_ATTRS=m
CONFIG_ISCSI_TCP=m

# Network-lab devices and encapsulation. CONFIG_VLAN_8021Q is deliberately
# absent because it changes vendor-visible networking ABI in Microsoft's tree.
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_BONDING=y
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_VXLAN=m
CONFIG_NET_IPGRE=m
CONFIG_NET_IPIP=m

# Useful packet-processing and traffic-control modules
CONFIG_NETFILTER_XT_SET=m
CONFIG_IP_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_ACT_MIRRED=y
